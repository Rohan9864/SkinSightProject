# ══════════════════════════════════════════════════════════════
# PYTHON / DJANGO (SkinSightML)
# ══════════════════════════════════════════════════════════════

# Virtual environment
SkinSightML/venv/
SkinSightML/env/
SkinSightML/.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Django database and logs
SkinSightML/skinsight_ml/db.sqlite3
SkinSightML/skinsight_ml/*.log

# ML model weights — GitHub limit is 100MB
SkinSightML/skinsight_ml/models/*.pth
SkinSightML/skinsight_ml/models/*.pt
SkinSightML/skinsight_ml/models/*.h5
SkinSightML/skinsight_ml/models/*.ckpt
SkinSightML/skinsight_ml/models/*.pkl
SkinSightML/skinsight_ml/models/*.bin

# Allow README and gitkeep inside models/
!SkinSightML/skinsight_ml/models/README.md
!SkinSightML/skinsight_ml/models/.gitkeep

# Training data and checkpoints
SkinSightML/skinsight_ml/training/data/
SkinSightML/skinsight_ml/training/checkpoints/

# Allow training source files
!SkinSightML/skinsight_ml/training/README.md
!SkinSightML/skinsight_ml/training/train_convnext.ipynb
!SkinSightML/skinsight_ml/training/requirements_training.txt
!SkinSightML/skinsight_ml/training/.gitkeep

# Django secrets
SkinSightML/skinsight_ml/.env

# ══════════════════════════════════════════════════════════════
# UPLOADS — runtime generated, never pushed
# ══════════════════════════════════════════════════════════════
uploads/

# ══════════════════════════════════════════════════════════════
# JAVA / SPRING BOOT (SkinSightBackend)
# ══════════════════════════════════════════════════════════════

# Maven build output
SkinSightBackend/target/

# Spring Boot secrets
SkinSightBackend/src/main/resources/application-local.properties

# Spring Boot logs
SkinSightBackend/*.log
SkinSightBackend/logs/

# ══════════════════════════════════════════════════════════════
# REACT / VITE (SkinSightFrontend)
# ══════════════════════════════════════════════════════════════

# Dependencies — never push, always npm install
SkinSightFrontend/skinsight-frontend/node_modules/

# Vite build output
SkinSightFrontend/skinsight-frontend/dist/
SkinSightFrontend/skinsight-frontend/dist-ssr/

# Environment files
SkinSightFrontend/skinsight-frontend/.env
SkinSightFrontend/skinsight-frontend/.env.local
SkinSightFrontend/skinsight-frontend/.env.production

# Vite cache
SkinSightFrontend/skinsight-frontend/.vite/

# npm logs
SkinSightFrontend/skinsight-frontend/npm-debug.log*
SkinSightFrontend/skinsight-frontend/yarn-debug.log*
SkinSightFrontend/skinsight-frontend/yarn-error.log*

# ══════════════════════════════════════════════════════════════
# IDE FILES
# ══════════════════════════════════════════════════════════════
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
*.code-workspace
.project
.classpath
.settings/
.factorypath

# Allow VS Code settings we deliberately created
!SkinSightFrontend/skinsight-frontend/.vscode/settings.json

# ══════════════════════════════════════════════════════════════
# OS FILES
# ══════════════════════════════════════════════════════════════
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ══════════════════════════════════════════════════════════════
# ENVIRONMENT FILES (catches any remaining level)
# ══════════════════════════════════════════════════════════════
.env
.env.local
.env.production
.env.development
.env.test

# ══════════════════════════════════════════════════════════════
# LOGS (any level)
# ══════════════════════════════════════════════════════════════
*.log
logs/

# ══════════════════════════════════════════════════════════════
# MISC
# ══════════════════════════════════════════════════════════════
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local