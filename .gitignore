# ══════════════════════════════════════════════════════════════
# PYTHON / DJANGO (SkinSightML)
# ══════════════════════════════════════════════════════════════

# Virtual environment
SkinSightML/venv/
SkinSightML/env/
SkinSightML/.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Django specific
SkinSightML/skinsight_ml/db.sqlite3
SkinSightML/skinsight_ml/*.log

# ML model weights — too large for GitHub
SkinSightML/skinsight_ml/models/*.pth
SkinSightML/skinsight_ml/models/*.pt
SkinSightML/skinsight_ml/models/*.h5

# Django secrets
SkinSightML/skinsight_ml/.env

# ══════════════════════════════════════════════════════════════
# UPLOADS — created at runtime by both Spring Boot and Django
# Lives at project root level not inside any subfolder
# ══════════════════════════════════════════════════════════════
uploads/
# This single line covers the uploads/ folder
# wherever it gets created at the root level.
# Spring Boot creates: uploads/cases/ uploads/heatmaps/ uploads/reports/
# Django reads from:   uploads/cases/
# Django writes to:    uploads/heatmaps/
# Neither should be pushed — they are runtime files.

# ══════════════════════════════════════════════════════════════
# JAVA / SPRING BOOT (SkinSightBackend)
# ══════════════════════════════════════════════════════════════

# Maven build output
SkinSightBackend/target/

# Spring Boot secrets
SkinSightBackend/src/main/resources/application-local.properties

# Spring Boot logs
SkinSightBackend/*.log
SkinSightBackend/logs/

